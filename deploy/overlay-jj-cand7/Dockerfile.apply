ARG OVERLAY=ghcr.io/lan-avelino/vllm-jj-overlay:jj-cand7
ARG BASE=ghcr.io/local-inference-lab/vllm:karmic-kraken-beta-20261002-7b398c9e420c91eb@sha256:2230db60afb4fd06dc2ef2b7f7f27dc7f78d7a50be70a08461b4df9fa5e90732
FROM ${OVERLAY} AS overlay-src
FROM ${BASE}
ARG SITE=/opt/venv/lib/python3.12/site-packages
# Refuse to overlay a base whose files differ from the ones this overlay was cut
# from (vLLM 93dabce32f; hashes match the release's runtime-files manifest).
RUN cd ${SITE} && printf '%s  %s\n' \
      81f987ff50353ed64076cb462036758765f6c007c3849c773b1b181f58c21414 vllm/v1/core/sched/scheduler.py \
      9807a36c740b874d012a8091890711599e1a4f5907ef9380ffc03adeb000f8fa vllm/v1/worker/gpu/structured_outputs.py \
      ccaaae9863bc004540510495251eb3e4ef0bb9aad6e021f620f504309d6ab4a6 vllm/envs.py \
      a6041ddf35d7aebb8452697ed16274451af533042acfc46760860725d153f5cb vllm/v1/structured_output/backend_xgrammar.py \
      913519ce6b80d0551a6ab6bd1bc5988777310b9d0c0c9745ce805dd004470e20 vllm/config/engram.py \
      be4efe504e362d3cc5aa0241234b547f865c148aff3b2a99e263b8c1c6e58fdd vllm/models/deepseek_v41/common/engram.py \
      9c644c1fed14c73b25455baa75d13b091a2431ba057865b180f0d3e03062efb0 vllm/models/deepseek_v41/nvidia/engram.py \
      bfc500c4989607809577cbd10512b96e9162a7359ad407f772b7f695eaa34cd9 vllm/models/deepseek_v41/quant_config.py \
      efda07bdd54d947852cdf75095905033038cf2a4425d7b234d092a9253c7c811 vllm/models/deepseek_v4_1/common/engram.py \
      0cb3bd8793ae4e377b634d4684c7c992af26d4c28261da4a13dc45c56e90e882 vllm/models/deepseek_v4_1/quant_config.py \
    | sha256sum -c - && test ! -e vllm/v1/worker/gpu/structured_outputs_warmup.py
COPY --from=overlay-src /overlay/ ${SITE}/
RUN /opt/venv/bin/python -m compileall -q ${SITE}/vllm/envs.py ${SITE}/vllm/v1/core/sched ${SITE}/vllm/v1/worker/gpu ${SITE}/vllm/v1/structured_output ${SITE}/vllm/config/engram.py ${SITE}/vllm/models/deepseek_v41 ${SITE}/vllm/models/deepseek_v4_1 > /dev/null && echo "overlay syntax ok"
LABEL org.opencontainers.image.title="vllm-jj-cand7" \
      org.opencontainers.image.description="cand6 + NVFP4 routed experts on the SM120 DeepSeek-V4.1 stack + MXFP4-packed Engram tables (vllm #61530) + MXFP4 DSpark experts in NVFP4 exports (vllm #59655)" \
      org.opencontainers.image.source="https://github.com/lan-avelino/vllm-jj" \
      org.opencontainers.image.base.name="ghcr.io/local-inference-lab/vllm:karmic-kraken-beta-20261002-7b398c9e420c91eb" \
      org.opencontainers.image.base.digest="sha256:2230db60afb4fd06dc2ef2b7f7f27dc7f78d7a50be70a08461b4df9fa5e90732"
